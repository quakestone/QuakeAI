# Rust 构建产物（build/ 内的 index.js / index_bg.wasm 例外——部署必需，随仓库提交）
/target
/build/*
!/build/index.js
!/build/index_bg.wasm

# 日志 / 临时
*.log
workerd.retry.capnp
workerd.retry2.capnp
workerd.flaky.capnp

# 依赖与本地环境
node_modules/
.env
.dev.vars
.wrangler/

# 本地运行时二进制（workerd 由脚本按需下载，不入库）
.tools/

# 本地 DO 持久化存储（workerd localDisk；渠道/Key 只在本机，绝不出现在仓库里）
.wd-storage/

# 浏览器验证工具缓存
.playwright-cli/
